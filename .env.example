# Chave de API da OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo de embeddings (gera os vetores dos chunks e das perguntas)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelo de LLM usado para responder às perguntas
OPENAI_LLM_MODEL=gpt-6-luna

# Conexão com o PostgreSQL + pgVector (mesmo usuário/senha/banco do docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Nome da collection de vetores criada na ingestão
PG_VECTOR_COLLECTION_NAME=document_pdf

# Caminho do PDF que será ingerido
PDF_PATH=document.pdf
